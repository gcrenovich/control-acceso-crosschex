# Puerto del servidor backend
PORT=3005

# Entorno: 'development' o 'production' (en production se ocultan detalles de errores internos)
NODE_ENV=production

# Orígenes CORS permitidos (separados por coma). Dejar vacío para permitir solo peticiones locales/LAN en desarrollo.
ALLOWED_ORIGINS=http://localhost:5173,http://10.0.0.109:5173

# Clave secreta para endpoints protegidos (Sincronización manual e ingesta de datos)
# Envíe esta clave en la cabecera HTTP 'x-api-key: tu_clave_secreta'
API_KEY=mi_clave_secreta_crosschex_2026

# Intervalo de auto-sincronización periódica en segundos (0 para deshabilitar en Ubuntu y usar ingesta push)
AUTO_SYNC_INTERVAL_SEC=0
